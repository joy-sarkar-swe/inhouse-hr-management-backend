# ── Core Server Configuration ───────────────────────────────────────────────
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:3001

# ── Docker PostgreSQL Database Settings ─────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=hr_management_db
POSTGRES_PORT=5439

# ── Database Connection URL (Prisma) ──────────────────────────────────────
# Port 5439 maps to host machine to prevent conflicts with native Windows Postgres
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5439/hr_management_db?schema=public"

# ── JWT & Authentication Security ───────────────────────────────────────────
JWT_SECRET=super_secret_jwt_key_hr_management_system_2026_change_in_production
JWT_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800
BCRYPT_SALT_ROUNDS=12

# ── Redis Cache & Queue Connection ─────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB_AUTH=1
REDIS_DB_THROTTLE=3
REDIS_DB_EMAIL_QUEUE=4
REDIS_DB_AUTH_EMAIL_QUEUE=5
REDIS_DB_SIGNED_URL_CACHE=12

# ── Transactional Email (SMTP / Nodemailer) ─────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=hr.notifications@example.com
MAIL_PASS=your_email_app_password
MAIL_FROM_NAME="HR Management System"
MAIL_FROM_EMAIL=no-reply@example.com

# ── Application Branding ───────────────────────────────────────────────────
APP_NAME="HR Management System"
SUPPORT_EMAIL=support@company.com

# ── Rate Limiting & Performance ─────────────────────────────────────────────
THROTTLE_ENABLED=true
TRUSTED_PROXIES=127.0.0.1

# ── Optional GCP Cloud Storage (Avatar & Document Uploads) ─────────────────
GCP_PROJECT_ID=hr-management-prod
GCP_BUCKET_NAME=hr-management-assets
GCP_SERVICE_ACCOUNT_JSON=
