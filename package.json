{
  "name": "nest-auth-template",
  "version": "0.1.0",
  "description": "NestJS template: email/password auth, user profiles, transactional email, health checks — with production-grade Redis caching, Bloom filters, multi-layer rate limiting, and circuit breakers.",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "npx prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "docker compose -f dev.docker-compose.yml up -d postgres redis && nest start",
    "start:dev": "docker compose -f dev.docker-compose.yml up -d postgres redis && cross-env NODE_OPTIONS=--dns-result-order=ipv4first nest start --watch",
    "start:debug": "docker compose -f dev.docker-compose.yml up -d postgres redis && cross-env NODE_OPTIONS=--dns-result-order=ipv4first nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "npx eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "npx jest",
    "test:watch": "npx jest --watch",
    "test:cov": "npx jest --coverage",
    "test:e2e": "npx jest --config ./test/jest-e2e.json",
    "docker:dev:up": "docker compose -f dev.docker-compose.yml up -d --build",
    "docker:dev:down": "docker compose -f dev.docker-compose.yml down",
    "docker:dev:logs": "docker compose -f dev.docker-compose.yml logs -f",
    "docker:dev:restart": "docker compose -f dev.docker-compose.yml restart",
    "docker:prod:up": "docker compose -f docker-compose.yml up -d --build",
    "docker:prod:down": "docker compose -f docker-compose.yml down",
    "docker:prod:logs": "docker compose -f docker-compose.yml logs -f",
    "docker:prod:restart": "docker compose -f docker-compose.yml restart",
    "prisma:generate": "npx prisma generate",
    "prisma:migrate": "npx prisma migrate dev",
    "prisma:deploy": "npx prisma migrate deploy",
    "prisma:studio": "npx prisma studio",
    "prisma:seed": "npx ts-node prisma/seed.ts",
    "prisma:reset": "npx prisma migrate reset --force",
    "setup": "docker compose -f dev.docker-compose.yml up -d postgres redis && npm install && npm run prisma:generate && npm run prisma:migrate && npm run prisma:seed"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/static": "^9.3.0",
    "@google-cloud/storage": "^7.21.0",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-fastify": "^11.1.28",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.6",
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.80.11",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "confbox": "^0.2.4",
    "dotenv": "^17.4.2",
    "fastify": "^5.10.0",
    "image-size": "^2.0.2",
    "ioredis": "^5.11.1",
    "nodemailer": "^9.0.3",
    "opossum": "^10.0.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.28",
    "@types/bcrypt": "^6.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.1",
    "@types/nodemailer": "^8.0.1",
    "@types/opossum": "^8.1.9",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.7.0",
    "jest": "^30.4.2",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "prisma": "^6.19.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "overrides": {
    "typescript": "^6.0.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(uuid|@google-cloud/storage)/)"
    ],
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
